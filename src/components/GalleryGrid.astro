---
import { Image } from 'astro:assets';

export interface Props {
  images: Array<{
    src: string;
    alt: string;
    title?: string;
  }>;
  columns?: number;
}

const { images, columns = 3 } = Astro.props;
---
<div class="gallery-grid" data-columns={columns}>
  {images.map((image, index) => (
    <figure class="gallery-item">
      <div class="image-wrapper">
        <Image 
          src={image.src} 
          alt={image.alt || ''} 
          width={1200} 
          height={1800}
          format="webp"
          loading={index < 6 ? "eager" : "lazy"}
          quality={85}
        />
      </div>
      {image.title && <figcaption class="image-caption">{image.title}</figcaption>}
    </figure>
  ))}
</div>