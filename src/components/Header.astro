---
const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/gallery", label: "Galería" },
  { href: "/about", label: "Sobre mí" },
];
---
<header class="header">
  <nav class="nav">
    <a href="/" class="brand-link">
      <span class="brand-name">María Camila Porras</span>
      <span class="brand-subtitle">Fotografía</span>
    </a>
    <div class="nav-spacer"></div>
    <ul class="nav-menu">
      { navItems.map((item) => (
        <li class="nav-item">
          <a href={item.href} class="nav-link">{item.label}</a>
        </li>
      )) }
    </ul>
  </nav>
</header>
