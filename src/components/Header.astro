---
import IconMoon from './icons/IconMoon.astro';
import IconSun from './icons/IconSun.astro';
import { site } from '../data/site';
---

<header class="header">
  <nav class="nav" aria-label="Navegación principal">
    <a href="#inicio" class="brand-link">
      <span class="brand-name">{site.name}</span>
      <span class="brand-subtitle">{site.tagline}</span>
    </a>
    <button
      type="button"
      class="nav-toggle"
      id="navToggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="navMenu"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
    <ul class="nav-menu" id="navMenu">
      <li class="nav-item">
        <a href="#inicio" class="nav-link">Inicio</a>
      </li>
      <li class="nav-item">
        <a href="#gallery" class="nav-link">Galería</a>
      </li>
      <li class="nav-item">
        <a href="#about" class="nav-link">Sobre mí</a>
      </li>
      <li class="nav-item">
        <button
          type="button"
          class="theme-toggle"
          id="themeToggle"
          aria-label="Activar modo oscuro"
          aria-pressed="false"
        >
          <IconMoon />
          <IconSun />
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  import { initThemeToggle } from '../scripts/theme';

  initThemeToggle();

  const navToggle = document.getElementById('navToggle');
  const navMenu = document.getElementById('navMenu');

  function setMenuOpen(open: boolean): void {
    navMenu?.classList.toggle('nav-menu-open', open);
    if (navToggle instanceof HTMLButtonElement) {
      navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      navToggle.setAttribute(
        'aria-label',
        open ? 'Cerrar menú' : 'Abrir menú',
      );
    }
  }

  if (navToggle instanceof HTMLButtonElement && navMenu) {
    navToggle.addEventListener('click', () => {
      setMenuOpen(!navMenu.classList.contains('nav-menu-open'));
    });

    navMenu.querySelectorAll('.nav-link').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    document.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'Escape') setMenuOpen(false);
    });
  }
</script>
