---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GalleryGrid from '../components/GalleryGrid.astro';

const galleryImages = [
  { src: "/src/images/001.jpg", alt: "" },
  { src: "/src/images/002.jpg", alt: "" },
  { src: "/src/images/003.jpg", alt: "" },
  { src: "/src/images/004.jpg", alt: "" },
  { src: "/src/images/005.jpg", alt: "" },
  { src: "/src/images/006.jpg", alt: "" },
];
---

<BaseLayout title="Galería | La Dibujadora de Luz">
  <Header />
  <main class="main">
    <section class="gallery-header">
      <h1 class="page-title">Galería</h1>
      <p class="page-subtitle">Selección de trabajos fotográficos</p>
    </section>

    <section class="gallery-section">
      <GalleryGrid images={galleryImages} columns={3} />
    </section>
  </main>
  <Footer />
</BaseLayout>
